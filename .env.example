# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 커밋 금지)
SECRET_KEY=
# 공공데이터포털 일반 인증키 (상가정보·TourAPI 공용, 수집 스크립트에서만 사용)
DATA_GO_KR_KEY=
# 네이버 지도 Client ID (비우면 OpenStreetMap 지도)
NAVER_MAP_CLIENT_ID=
# 선택: SQLite 파일 위치 (비우면 프로젝트 폴더의 trippin.db)
TRIPPIN_DB=
# Google Places API (New) 키 (data/tools/collect_google.py)
GOOGLE_PLACES_KEY=
